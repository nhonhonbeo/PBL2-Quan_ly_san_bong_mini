+        }
+
+        ImGui::PopStyleVar(3);
+        ImGui::PopStyleColor(2);
+
+        int matchingCount = 0;
+        for (auto* node = danhSachCoSo_.get_head(); node != nullptr; node = node->next) {
+            const VenueFacilityRecord& facility = node->data;
+            if (!tuKhoaCoSo_.empty() &&
