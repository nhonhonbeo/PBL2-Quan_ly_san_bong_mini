diff --git a/include/Core/IdGenerator.h b/include/Core/IdGenerator.h
new file mode 100644
index 0000000..02516ed
--- /dev/null
+++ b/include/Core/IdGenerator.h
@@ -0,0 +1,54 @@
+#pragma once
+
+#include <cstdio>
+#include <string>
+#include <utility>
+
+// Sinh mã định danh dạng <tiền tố><số thứ tự>, ví dụ "RV07", "GD-12", "TM-03".
+//
+// LÝ DO CHỌN: gom logic "quét số thứ tự lớn nhất rồi + 1" về một chỗ (trước đây bị
+// sao chép ở AccountService, CustomerService, TournamentService, FieldService).
+// Dùng max-sequence thay vì đếm size() + 1 để không trùng ID khi có bản ghi bị xóa.
+// Lớp không phụ thuộc kiểu container: nơi gọi tự duyệt danh sách và gọi observe().
+class IdGenerator {
+public:
+    // width: số chữ số tối thiểu (đệm số 0 bên trái), ví dụ width = 2 -> "01".
+    explicit IdGenerator(std::string prefix, int width = 2)
+        : prefix_(std::move(prefix)), width_(width) {}
+
+    // Ghi nhận một ID đã tồn tại. ID sai tiền tố hoặc phần số không hợp lệ bị bỏ qua.
+    void observe(const std::string& id) {
+        if (id.size() <= prefix_.size() || id.compare(0, prefix_.size(), prefix_) != 0) {
+            return;
+        }
+        const std::string tail = id.substr(prefix_.size());
+        for (char c : tail) {
+            if (c < '0' || c > '9') return;
+        }
+        try {
+            const int seq = std::stoi(tail);
+            if (seq > max_seq_) max_seq_ = seq;
+        } catch (...) {
+            // Phần số quá lớn: bỏ qua giống hành vi cũ (catch(...) {}).
+        }
+    }
+
+    int maxSequence() const { return max_seq_; }
+
+    // Sinh ID kế tiếp rồi tự tăng bộ đếm, nên gọi liên tiếp sẽ không trùng nhau.
+    std::string next() {
+        ++max_seq_;
+        return format(prefix_, max_seq_, width_);
+    }
+
+    static std::string format(const std::string& prefix, int seq, int width = 2) {
+        char buf[16];
+        std::snprintf(buf, sizeof(buf), "%0*d", width, seq);
+        return prefix + buf;
+    }
+
+private:
+    std::string prefix_;
+    int width_;
+    int max_seq_ = 0;
+};
diff --git a/include/GUI/App/FacadeMappers.h b/include/GUI/App/FacadeMappers.h
new file mode 100644
index 0000000..3d29f28
--- /dev/null
+++ b/include/GUI/App/FacadeMappers.h
@@ -0,0 +1,50 @@
+﻿#pragma once
+// Hàm tiện ích nội bộ dùng chung cho các file Facade*.cpp (không phải API công khai).
+// LÝ DO CHỌN: tách khỏi Facade.cpp để mỗi file Facade* chỉ chứa một nhóm chức năng
+// mà vẫn dùng chung một bộ hàm ánh xạ (tránh sao chép).
+#include <string>
+
+#include "Core/DateTime.h"
+#include "GUI/App/Facade.h"
+#include "Tournament/Tournament.h"
+
+namespace GUI::App::detail {
+
+inline bool tachKhungGio(const std::string& text, std::string& start, std::string& end, int& duration) {
+    const std::size_t sep = text.find(" - ");
+    if (sep == std::string::npos) return false;
+    start = text.substr(0, sep); end = text.substr(sep + 3);
+    if (!DateTime::isValidTime(start) || !DateTime::isValidTime(end)) return false;
+    duration = (std::stoi(end.substr(0, 2)) * 60 + std::stoi(end.substr(3, 2))) -
+               (std::stoi(start.substr(0, 2)) * 60 + std::stoi(start.substr(3, 2)));
+    return duration == 60 || duration == 90;
+}
+
+inline int gioSangPhut(const std::string& timeStr) {
+    return (timeStr.length() == 5 && timeStr[2] == ':') ?
+        std::stoi(timeStr.substr(0, 2)) * 60 + std::stoi(timeStr.substr(3, 2)) : 0;
+}
+
+
+inline Tournament toTournament(const GiaiDauInfo& g, TournamentStatus st) {
+    return Tournament(g.maGiai, g.sdtKhach, g.tenGiai, g.maSan,
+                      g.ngayBatDau, g.ngayKetThuc, g.moTa,
+                      st, "", g.tenKhachDat, g.khungGio, g.ghiChuTuChoi);
+}
+
+inline GiaiDauInfo toGiaiDauInfo(const Tournament& t) {
+    return {t.getTournamentId(), t.getName(), t.getRequesterName(), t.getRequesterUserId(),
+            t.getStartDate(), t.getEndDate(), t.getRequestedFieldId(), t.getTimeSlot(),
+            t.getNote(), t.getRejectReason(), static_cast<TrangThaiGiaiDau>(static_cast<int>(t.getStatus()))};
+}
+
+inline DonDatSanInfo toBookingInfo(const ReportBookingRecord& record) {
+    DonDatSanInfo b;
+    b.maDon = record.bookingId; b.maSan = record.fieldId; b.ownerUserId = record.ownerUserId;
+    b.customerId = record.customerId; b.tenKhachHang = record.customerName; b.sdt = record.customerPhone;
+    b.ngay = record.date; b.khungGio = record.timeSlot.empty() ? (record.startTime + " - " + record.endTime) : record.timeSlot;
+    b.thoiLuongPhut = record.durationMinutes; b.giaTien = static_cast<int>(record.amountVnd); b.trangThai = record.status;
+    return b;
+}
+
+}  // namespace GUI::App::detail
diff --git a/include/GUI/App/ViewFormat.h b/include/GUI/App/ViewFormat.h
new file mode 100644
index 0000000..40351d3
--- /dev/null
+++ b/include/GUI/App/ViewFormat.h
@@ -0,0 +1,32 @@
+#pragma once
+// Hàm định dạng văn bản hiển thị dùng chung cho các màn hình.
+// LÝ DO CHỌN: trước đây dinhDangTien / ngayHienThi bị sao chép ở 4 màn hình, mỗi bản
+// một kiểu; gom về đây để sửa định dạng một lần là đúng ở mọi nơi.
+#include <string>
+
+#include "Core/DateTime.h"
+
+namespace GUI::App::ViewFormat {
+
+// 1234567 -> "1.234.567" (không kèm đơn vị; xử lý đúng cả số âm).
+inline std::string nhomNghin(long long value) {
+    const bool am = value < 0;
+    std::string digits = std::to_string(am ? -value : value);
+    for (int index = static_cast<int>(digits.size()) - 3; index > 0; index -= 3) {
+        digits.insert(static_cast<std::size_t>(index), ".");
+    }
+    return am ? "-" + digits : digits;
+}
+
+// 1234567 -> "1.234.567 VNĐ"
+inline std::string dinhDangTien(long long value) {
+    return nhomNghin(value) + u8" VNĐ";
+}
+
+// "2026-10-20" -> "20/10/2026"; chuỗi không phải ngày ISO được giữ nguyên.
+inline std::string ngayHienThi(const std::string& isoDate) {
+    if (!DateTime::isValidDate(isoDate)) return isoDate;
+    return isoDate.substr(8, 2) + "/" + isoDate.substr(5, 2) + "/" + isoDate.substr(0, 4);
+}
+
+}  // namespace GUI::App::ViewFormat
