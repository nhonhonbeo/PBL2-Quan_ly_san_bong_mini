+        }
+
+        ImGui::SameLine(0.0f, 12.0f);
+
+        if (Widgets::NutPhu(u8"Hủy bỏ", ImVec2(100.0f, 32.0f))) {
+            ImGui::CloseCurrentPopup();
+        }
+
+        ImGui::EndPopup();
+    }
