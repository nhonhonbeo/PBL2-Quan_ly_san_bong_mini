+// Hàm che một phần số điện thoại để hiển thị công khai (ví dụ: 090***5678)
+std::string maHoaSDT(const std::string& sdt) {
+    if (sdt.length() >= 7) {
+        return sdt.substr(0, 3) + "***" + sdt.substr(sdt.length() - 4);
+    }
+    return sdt;
+}
