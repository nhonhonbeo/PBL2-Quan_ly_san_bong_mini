+bool Facade::getBaoCaoDashboard(ReportDashboardMetrics& metrics, LinkedList<ReportRevenueDay>& doanhThuTheoNgay,
+                                LinkedList<ReportBookingRecord>& luotDatGanDay, std::string& error) const {
