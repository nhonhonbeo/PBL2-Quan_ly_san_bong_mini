@@ -0,0 +1,36 @@
+#include <cassert>
+#include <iostream>
+
+#include "Core/IdGenerator.h"
+
+int main() {
+    {   // Danh sách rỗng -> bắt đầu từ 01
+        IdGenerator g("RV");
+        assert(g.next() == "RV01");
+        assert(g.next() == "RV02");  // gọi liên tiếp không trùng
+    }
+    {   // Có lỗ hổng do xóa bản ghi: lấy max + 1, không phải size + 1
+        IdGenerator g("GD-");
+        g.observe("GD-01");
+        g.observe("GD-07");
+        g.observe("GD-03");
+        assert(g.next() == "GD-08");
+    }
+    {   // ID sai tiền tố / phần số hỏng bị bỏ qua
+        IdGenerator g("TM-");
+        g.observe("MTH-09");
+        g.observe("TM-");
+        g.observe("TM-abc");
+        g.observe("TM-5x");
+        g.observe("TM-04");
+        assert(g.maxSequence() == 4);
+    }
+    {   // Vượt độ rộng tối thiểu vẫn đúng
+        IdGenerator g("US");
+        g.observe("US99");
+        assert(g.next() == "US100");
+        assert(IdGenerator::format("S5-", 3) == "S5-03");
+    }
+    std::cout << ">>> IDGENERATOR: ALL TESTS PASSED! <<<\n";
+    return 0;
+}
