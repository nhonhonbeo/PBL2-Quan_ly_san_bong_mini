+                facility.address.find(tuKhoaCoSo_) == std::string::npos) {
+                continue;
+            }
+            ++matchingCount;
+        }
+
+        ImGui::SameLine(0.0f, 18.0f);
+        ImGui::AlignTextToFramePadding();
+        ImGui::PushStyleColor(ImGuiCol_Text, GUI::Theme::Colors::TextSecondary);
