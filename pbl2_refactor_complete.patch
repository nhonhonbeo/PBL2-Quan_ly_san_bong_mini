@@ -0,0 +1,78 @@
+#include "GUI/Widgets/StepIndicator.h"
+
+#include <algorithm>
+#include <string>
+
+#include <imgui.h>
+
+#include "GUI/Theme/Theme.h"
+
+namespace Widgets {
+
+void ThanhCacBuoc(const std::vector<std::string>& nhanCacBuoc, int buocHienTai) {
+    const int soBuoc = static_cast<int>(nhanCacBuoc.size());
+    if (soBuoc <= 0) return;
+
+    using GUI::Theme::Colors;
+    constexpr float kKhoangCach = 8.0f;   // giữa các đoạn
+    constexpr float kDoDayThanh = 4.0f;   // thanh màu phía trên mỗi bước
+    constexpr float kBanKinh = 11.0f;     // vòng tròn số thứ tự
+    constexpr float kCachThanh = 10.0f;   // thanh -> vòng tròn
+
+    const float tongRong = ImGui::GetContentRegionAvail().x;
+    const float rongMotBuoc = std::max(
+        60.0f, (tongRong - kKhoangCach * static_cast<float>(soBuoc - 1)) / static_cast<float>(soBuoc));
+    const ImVec2 goc = ImGui::GetCursorScreenPos();
+    ImDrawList* dl = ImGui::GetWindowDrawList();
+
+    const ImU32 mauChinh = Colors::toU32(Colors::Primary);
+    const ImU32 mauVien = Colors::toU32(Colors::Border);
+    const ImU32 mauVienNhap = Colors::toU32(Colors::InputBorder);
+    const ImU32 mauNen = Colors::toU32(Colors::Surface);
+    const ImU32 mauChuPhu = Colors::toU32(Colors::TextSecondary);
+    const ImU32 mauChuChinh = Colors::toU32(Colors::TextPrimary);
+
+    for (int i = 0; i < soBuoc; ++i) {
+        const int buoc = i + 1;
+        const bool daXong = buoc < buocHienTai;
+        const bool hienTai = buoc == buocHienTai;
+        const float x0 = goc.x + static_cast<float>(i) * (rongMotBuoc + kKhoangCach);
+
+        dl->AddRectFilled(ImVec2(x0, goc.y), ImVec2(x0 + rongMotBuoc, goc.y + kDoDayThanh),
+                          (daXong || hienTai) ? mauChinh : mauVien, 2.0f);
+
+        const ImVec2 tam(x0 + kBanKinh, goc.y + kDoDayThanh + kCachThanh + kBanKinh);
+        if (daXong || hienTai) {
+            dl->AddCircleFilled(tam, kBanKinh, mauChinh);
+        } else {
+            dl->AddCircleFilled(tam, kBanKinh, mauNen);
+            dl->AddCircle(tam, kBanKinh, mauVienNhap, 0, 1.5f);
+        }
+
+        if (daXong) {
+            // Dấu tick vẽ bằng đường gấp khúc, không dùng ký tự font.
+            const ImVec2 tick[3] = {ImVec2(tam.x - 4.5f, tam.y + 0.5f),
+                                    ImVec2(tam.x - 1.5f, tam.y + 3.5f),
+                                    ImVec2(tam.x + 5.0f, tam.y - 3.5f)};
+            dl->AddPolyline(tick, 3, IM_COL32_WHITE, ImDrawFlags_None, 2.0f);
+        } else {
+            const std::string so = std::to_string(buoc);
+            const ImVec2 kichThuoc = ImGui::CalcTextSize(so.c_str());
+            dl->AddText(ImVec2(tam.x - kichThuoc.x * 0.5f, tam.y - kichThuoc.y * 0.5f),
+                        hienTai ? IM_COL32_WHITE : mauChuPhu, so.c_str());
+        }
+
+        // Nhãn bên phải vòng tròn, cắt gọn nếu hẹp.
+        const std::string& nhan = nhanCacBuoc[static_cast<size_t>(i)];
+        const float xNhan = tam.x + kBanKinh + 8.0f;
+        const float caoChu = ImGui::GetTextLineHeight();
+        dl->PushClipRect(ImVec2(xNhan, goc.y), ImVec2(x0 + rongMotBuoc, goc.y + 60.0f), true);
+        dl->AddText(ImVec2(xNhan, tam.y - caoChu * 0.5f),
+                    hienTai ? mauChuChinh : (daXong ? mauChinh : mauChuPhu), nhan.c_str());
+        dl->PopClipRect();
+    }
+
+    ImGui::Dummy(ImVec2(tongRong, kDoDayThanh + kCachThanh + 2.0f * kBanKinh + 2.0f));
+}
+
+}  // namespace Widgets
